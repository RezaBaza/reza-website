---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Reza Bazargan – Data Strategist & AI Specialist',
  description: 'Senior Data Strategist helping organisations turn data into decisions that actually stick.',
  ignoreTitleTemplate: true,
};

const allPosts = await getCollection('post', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.publishDate ?? 0).getTime() - new Date(a.data.publishDate ?? 0).getTime())
  .slice(0, 3);

const categoryColors: Record<string, string> = {
  'AI in Practice': 'bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300',
  'Public Sector & AI': 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300',
  'Data Strategy': 'bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300',
  'Tools & Techniques': 'bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300',
};

function formatDate(date: Date | undefined) {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Layout metadata={metadata}>
  <div class="relative overflow-hidden">

    <!-- Particle canvas -->
    <canvas id="particle-canvas" class="fixed inset-0 z-0 w-full h-full pointer-events-none"></canvas>

    <!-- Hero -->
    <section class="relative z-10 max-w-2xl mx-auto px-4 pt-24 pb-16 text-center">
      <img
        src="/Reza_pic.png"
        alt="Reza Bazargan"
        class="w-20 h-20 rounded-full object-cover mx-auto mb-6 border-2 border-gray-200 dark:border-gray-700 shadow-md"
      />
      <h1 class="text-4xl font-bold mb-3 tracking-tight">Reza Bazargan</h1>
      <p class="text-lg text-muted mb-2">Senior Data Strategist · Governo Insikt AB · Stockholm</p>
      <p class="text-base text-muted max-w-lg mx-auto leading-relaxed mb-8">
        I help organisations turn data into decisions that actually stick — strategy, analytics, and applied AI.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/posts" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors">
          Read posts
        </a>
        <a href="/contact" class="px-5 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
          Get in touch
        </a>
        <a href="https://huggingface.co/spaces/RezaBaza/career_conversation" target="_blank" class="px-5 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
          Chat with my AI
        </a>
      </div>
    </section>

    <!-- Stats -->
    <section class="relative z-10 max-w-2xl mx-auto px-4 pb-16">
      <div class="grid grid-cols-4 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        <div class="py-5 text-center border-r border-gray-200 dark:border-gray-700">
          <div class="text-2xl font-bold">10+</div>
          <div class="text-xs text-muted mt-1">years</div>
        </div>
        <div class="py-5 text-center border-r border-gray-200 dark:border-gray-700">
          <div class="text-2xl font-bold">5+</div>
          <div class="text-xs text-muted mt-1">industries</div>
        </div>
        <div class="py-5 text-center border-r border-gray-200 dark:border-gray-700">
          <div class="text-2xl font-bold">3</div>
          <div class="text-xs text-muted mt-1">languages</div>
        </div>
        <div class="py-5 text-center">
          <div class="text-2xl font-bold">PhD</div>
          <div class="text-xs text-muted mt-1">mathematics</div>
        </div>
      </div>
    </section>

    <!-- Latest posts -->
    {latestPosts.length > 0 && (
      <section class="relative z-10 max-w-2xl mx-auto px-4 pb-20">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-base font-semibold uppercase tracking-widest text-muted text-sm">Latest writing</h2>
          <a href="/posts" class="text-sm text-blue-500 hover:underline">All posts →</a>
        </div>
        <div class="space-y-3">
          {latestPosts.map(post => (
            <a href={getPermalink(post.id, 'post')} class="group flex items-start gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-sm transition-all bg-white dark:bg-slate-900">
              {post.data.category && (
                <span class={`text-xs px-2 py-0.5 rounded-full font-medium whitespace-nowrap mt-0.5 ${categoryColors[post.data.category] ?? 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'}`}>
                  {post.data.category}
                </span>
              )}
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium group-hover:text-blue-500 transition-colors leading-snug mb-1">{post.data.title}</p>
                <p class="text-xs text-muted">{formatDate(post.data.publishDate)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Footer links -->
    <section class="relative z-10 max-w-2xl mx-auto px-4 pb-20 flex justify-center gap-6 text-sm text-muted">
      <a href="/about" class="hover:text-blue-500 transition-colors">About</a>
      <a href="/services" class="hover:text-blue-500 transition-colors">Services</a>
      <a href="/resume" class="hover:text-blue-500 transition-colors">Resume</a>
      <a href="https://github.com/RezaBaza" target="_blank" class="hover:text-blue-500 transition-colors">GitHub</a>
      <a href="https://www.linkedin.com/in/mrezabazargan/" target="_blank" class="hover:text-blue-500 transition-colors">LinkedIn</a>
    </section>

    <script src="/js/particles.js" defer></script>
  </div>
</Layout>
