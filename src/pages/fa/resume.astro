---
import Layout from '~/layouts/PageLayout.astro';
import { getTranslation, type Language } from '~/utils/translations';

const lang: Language = 'fa';
const t = getTranslation(lang);

const metadata = {
  title: t.resume.title,
  description: 'رزومه حرفه‌ای رضا بازرگان.',
};
---

<Layout metadata={metadata}>
<!-- 📸 Profile picture block -->
  <div class="max-w-3xl mx-auto mt-12 mb-6 px-4 text-center">
    <img
      src="/Reza_pic.png"
      alt="Reza Bazargan"
      class="w-32 h-32 md:w-40 md:h-40 rounded-full mx-auto border-4 border-primary object-cover shadow-lg"
    />
    <h1 class="text-2xl font-bold mt-4">Reza Bazargan</h1>
    <p class="text-muted">{t.resume.tagline}</p>
  </div>
  
  <section class="prose dark:prose-invert max-w-3xl mx-auto my-16 px-4" dir="rtl">
    <h1 class="text-3xl font-bold">{t.resume.resumeTitle}</h1>
    <p>
      {t.resume.description}
    </p>

    <h2>{t.resume.skills}</h2>
    <ul>
      <li><strong>{t.resume.languages}:</strong> Python, SQL</li>
      <li><strong>{t.resume.frameworks}:</strong> Hugging Face, OpenAI, scikit-learn</li>
      <li><strong>{t.resume.biViz}:</strong> Power BI, Tableau, Looker, HEX</li>
      <li><strong>{t.resume.leadership}:</strong> AI strategy, KPI frameworks, cross-functional mentoring</li>
    </ul>

    <h2>{t.resume.experience}</h2>
    <ul>
      <li><strong>Governo Insikt AB (2025–)</strong> – Senior Data Strategist</li>
      <li><strong>Mentimeter (2022–2024)</strong> – Analytics Manager</li>
      <li><strong>TallinkSilja AB (2016–2022)</strong> – Head of Revenue & Growth Analytics</li>
    </ul>

    <h2>{t.resume.download}</h2>
    <div class="flex flex-col sm:flex-row gap-4 mt-4">
      <a href="/RezaBazargan_CV_EN.pdf" target="_blank" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center">
        {t.resume.downloadEN}
      </a>
      <a href="/RezaBazargan_CV_SV.pdf" target="_blank" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center">
        {t.resume.downloadSV}
      </a>
    </div>
  </section>
</Layout>

