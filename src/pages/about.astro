---
import Layout from '~/layouts/PageLayout.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';

const metadata = {
  title: 'About – Reza Bazargan',
  description: 'PhD in Mathematics turned Data & AI Strategist. 10+ years building analytics teams and data-driven organisations across Nordic markets.',
};
---

<Layout metadata={metadata}>

  <!-- Hero -->
  <section class="max-w-4xl mx-auto px-4 py-16 flex flex-col md:flex-row items-center gap-10">
    <img
      src="/Reza_pic.png"
      alt="Reza Bazargan"
      class="w-40 h-40 rounded-full border-4 border-primary object-cover shadow-xl flex-shrink-0"
    />
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-500 mb-2">About me</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">From Mathematics to Data Strategy</h1>
      <p class="text-lg text-muted leading-relaxed">
        I started as a mathematician — PhD from Uppsala University, visiting scholar at UC Berkeley — and somewhere along the way I discovered that the most interesting problems weren't on chalkboards. They were in organisations trying to make better decisions with data they already had.
      </p>
    </div>
  </section>

  <!-- Story section -->
  <section class="max-w-3xl mx-auto px-4 pb-12 prose dark:prose-invert">
    <p>
      My career path is unconventional by design. After years in academia, teaching mathematics in Iran, researching at KTH and spending time at Berkeley, I made a deliberate shift into the commercial world. I joined the online travel industry as a pricing analyst in Stockholm and never looked back.
    </p>
    <p>
      Over the following decade I moved through increasingly senior roles at <strong>Travellink / eDreams OdigeO</strong>, <strong>TallinkSilja</strong>, and <strong>Mentimeter</strong>, building analytics teams from scratch, designing KPI frameworks, launching ML models for forecasting and customer segmentation, and sitting in the room with C-suite stakeholders when the question shifted from "what happened?" to "what do we do next?".
    </p>
    <p>
      Today I work as a <strong>Senior Data Strategist at Governo Insikt AB</strong>, where I help organisations define their analytical target state, build the right reporting structures, and actually use data in daily decisions, not just in slide decks. I also design and run applied AI workshops and proof-of-concept initiatives, always grounded in real operational needs.
    </p>
    <p>
      I believe most organisations already have enough data. What they lack is clarity on what to measure, who owns it, and how it connects to business outcomes. That's the problem I enjoy solving.
    </p>
  </section>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Years of experience', amount: '10+' },
      { title: 'Analytics teams built', amount: '3' },
      { title: 'Industries', amount: '5+' },
      //{ title: 'Languages spoken', amount: '3' },
    ]}
  />

  <!-- Career milestones -->
  <Steps2
    title="Career milestones"
    subtitle="A path from academic mathematics to commercial analytics leadership."
    items={[
      {
        title: 'Senior Data Strategist & Project Lead — Governo Insikt AB (2025–Present)',
        description:
          'Leading data and AI strategy engagements for complex organisations. Defining KPI structures, governance, and decision-support capabilities. Running applied AI/LLM workshops anchored in real business needs.',
      },
      {
        title: 'Sales & Marketing Analytics Manager — Mentimeter (2022–2024)',
        description:
          'Built and led the first dedicated analytics team. Designed the company-wide data strategy and single source of truth. Implemented lead scoring, forecasting models, and customer segmentation used across the full commercial funnel.',
      },
      {
        title: 'Growth Manager, Analytics — TallinkSilja AB (2021–2022)',
        description:
          'Led sales and marketing analytics in a Nordic travel business. Established the company\'s first data scientist role. Built ML-based RFM segmentation rolled out across markets and productionised in CRM.',
      },
      {
        title: 'Head of Revenue Management — TallinkSilja AB (2016–2021)',
        description:
          'Led revenue management and performance reporting for a major Nordic travel brand. Rolled out Tableau as the company-wide BI platform. Built KPI frameworks and near-real-time dashboards for commercial and operational stakeholders.',
      },
      {
        title: 'Revenue Manager & Pricing Analyst — eDreams OdigeO / Travellink (2013–2016)',
        description:
          'First commercial roles in online travel — pricing, demand analysis, and commercial performance. Built the analytical foundation that shaped the rest of my career.',
      },
      {
        title: 'Academia — KTH, Uppsala University, UC Berkeley, Azad University (2002–2013)',
        description:
          'PhD in Mathematics at Uppsala University (numerical methods & mathematical modelling). Visiting Scholar at UC Berkeley. Researcher & Lecturer at KTH. Faculty member in Iran for seven years.',
      },
    ]}
  />

  <!-- What I stand for -->
  <Features2
    title="How I work"
    subtitle="A few principles that shape every engagement."
    columns={3}
    items={[
      {
        title: 'Clarity over complexity',
        description:
          'A KPI framework nobody understands is worse than no framework. I focus on making the right things measurable and the outputs usable by the people who need them.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Bridge between worlds',
        description:
          'I am equally comfortable writing Python and presenting to a CFO. My job is to close the gap between what the data says and what the business needs to hear.',
        icon: 'tabler:arrows-exchange',
      },
      {
        title: 'Practical AI, not hype',
        description:
          'I only build AI solutions where the value is clear and the adoption is realistic. The most impressive model is worthless if it doesn\'t change how decisions get made.',
        icon: 'tabler:robot',
      },
    ]}
  />

  <!-- Skills -->
  <section class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-sm font-semibold uppercase tracking-widest text-blue-500 mb-6">Skills & tools</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Analytics & data</p>
        <div class="flex flex-wrap gap-2">
          {['Python', 'SQL', 'Machine learning', 'Generative AI', 'Statistical modelling', 'R'].map(s => (
            <span class="text-sm px-3 py-1 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 text-default">{s}</span>
          ))}
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">BI & reporting</p>
        <div class="flex flex-wrap gap-2">
          {['Tableau', 'Looker', 'Power BI', 'Looker Studio', 'Seaborn', 'Plotly', 'Matplotlib'].map(s => (
            <span class="text-sm px-3 py-1 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 text-default">{s}</span>
          ))}
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Marketing tech</p>
        <div class="flex flex-wrap gap-2">
          {['Salesforce', 'Google Analytics', 'Adobe Analytics', 'HubSpot', 'Mixpanel', '6sense', 'Google Ads'].map(s => (
            <span class="text-sm px-3 py-1 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 text-default">{s}</span>
          ))}
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-4">Languages</p>
        <div class="space-y-3">
          {[
            { lang: 'Swedish', level: 'Fluent', pct: 95 },
            { lang: 'English', level: 'Fluent', pct: 95 },
            { lang: 'Farsi', level: 'Native', pct: 100 },
          ].map(({ lang, level, pct }) => (
            <div class="flex items-center gap-3">
              <span class="text-sm w-16 flex-shrink-0">{lang}</span>
              <div class="flex-1 h-1.5 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" style={`width: ${pct}%`}></div>
              </div>
              <span class="text-xs text-muted w-12 text-right">{level}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-2xl mx-auto px-4 py-16 text-center">
    <h2 class="text-2xl font-bold mb-4">Want to work together?</h2>
    <p class="text-muted mb-6">I'm available for strategy engagements, advisory work, and AI/analytics projects across Nordic markets and beyond.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        Get in touch
      </a>
      <a href="/resume" class="px-6 py-3 border border-current rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        View my resume
      </a>
    </div>
  </section>

</Layout>
