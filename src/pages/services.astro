---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services – Reza Bazargan',
  description: 'Data strategy, analytics advisory, and applied AI services for organisations in the Nordic market and beyond.',
};
---

<Layout metadata={metadata}>

  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-4 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-blue-500 mb-3">What I do</p>
    <h1 class="text-4xl font-bold mb-6">Turning data into decisions that actually stick</h1>
    <p class="text-lg text-muted leading-relaxed">
      Most organisations don't have a data problem. They have a clarity problem — unclear ownership, fragmented metrics, and reports nobody acts on. I help fix that.
    </p>
  </section>

  <!-- Core services -->
  <Features2
    title="Services"
    subtitle="Three areas where I work — often overlapping, always grounded in practical business value."
    columns={3}
    items={[
      {
        title: 'Data & Analytics Strategy',
        description:
          'Define your analytical target state: what to measure, who owns it, and how it connects to business outcomes. Includes KPI frameworks, governance structures, roadmap development, and stakeholder alignment.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'BI & Reporting',
        description:
          'Build reporting that people actually use. From executive dashboards in Power BI, Tableau, or Looker to self-service analytics and automated decision-support — designed for clarity, not complexity.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Applied AI & ML',
        description:
          'Practical AI initiatives anchored in real needs: lead scoring, customer segmentation, forecasting models, LLM-powered tools, and AI readiness workshops. No hype — only what creates measurable value.',
        icon: 'tabler:robot',
      },
    ]}
  />

  <!-- How an engagement looks -->
  <Steps2
    title="How an engagement works"
    subtitle="A structured approach that moves from business need to working solution."
    items={[
      {
        title: 'Understand the business context',
        description:
          'Before any model or dashboard, I spend time understanding your commercial goals, existing data landscape, and where decisions are actually made. This shapes everything that follows.',
      },
      {
        title: 'Define the right questions',
        description:
          'Most analytics problems are really framing problems. I help translate vague ambitions ("we want to be more data-driven") into specific, answerable questions with clear ownership.',
      },
      {
        title: 'Build with adoption in mind',
        description:
          'Reports, models, and frameworks are only useful if they get used. Every deliverable is designed with the end user in mind — whether that\'s an analyst, a sales manager, or a CFO.',
      },
      {
        title: 'Transfer knowledge, not dependency',
        description:
          'I work closely with your team throughout, so the capability stays in-house after the engagement ends. Coaching and documentation are part of every project.',
      },
    ]}
  />

  <!-- Who I work with -->
  <Features2
    title="Who I work with"
    subtitle="Typically mid-sized organisations navigating a step-change in how they use data."
    columns={2}
    items={[
      {
        title: 'Scale-ups & SaaS companies',
        description:
          'Teams that have grown fast and now need to consolidate their data landscape, build a single source of truth, and measure what actually drives revenue.',
        icon: 'tabler:building',
      },
      {
        title: 'Enterprise & public sector',
        description:
          'Larger organisations with complex stakeholder structures that need external expertise to define strategy, run workshops, or accelerate a specific analytics initiative.',
        icon: 'tabler:buildings',
      },
      {
        title: 'Marketing & commercial teams',
        description:
          'Functions that sit between data and decision-making — needing better measurement of campaigns, customer journeys, conversion and retention, without drowning in dashboards.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Analytics teams',
        description:
          'Existing data or analytics functions that need a thought partner, a second opinion on strategy, or coaching on how to increase their business impact.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Let's talk about your situation"
    subtitle="Every engagement starts with a conversation. Tell me what you're trying to solve and I'll tell you honestly whether I can help."
    actions={[
      {
        variant: 'primary',
        text: 'Get in touch',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Read my background',
        href: '/about',
      },
    ]}
  />

</Layout>
