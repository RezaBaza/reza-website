---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Posts – Reza Bazargan',
  description: 'Essays and analysis on AI, data strategy, analytics leadership, and the Swedish public sector.',
};

const allPosts = await getCollection('post', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) =>
  new Date(b.data.publishDate ?? 0).getTime() - new Date(a.data.publishDate ?? 0).getTime()
);

const categories = [
  {
    id: 'AI in Practice',
    label: 'AI in Practice',
    description: 'What works, what doesn\'t, and how to cut through the hype — for everyone.',
    color: 'blue',
  },
  {
    id: 'Public Sector & AI',
    label: 'Public Sector & AI',
    description: 'AI and data in Swedish municipalities, regions, and government agencies.',
    color: 'green',
  },
  {
    id: 'Data Strategy',
    label: 'Data Strategy',
    description: 'How to build the analytical foundation that makes data actually useful.',
    color: 'purple',
  },
  {
    id: 'Tools & Techniques',
    label: 'Tools & Techniques',
    description: 'Hands-on guides for analysts and data practitioners.',
    color: 'orange',
  },
];

const colorMap: Record<string, { badge: string; border: string; dot: string }> = {
  blue:   { badge: 'bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300',   border: 'border-blue-500',   dot: 'bg-blue-500' },
  green:  { badge: 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300', border: 'border-green-500', dot: 'bg-green-500' },
  purple: { badge: 'bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300', border: 'border-purple-500', dot: 'bg-purple-500' },
  orange: { badge: 'bg-orange-100 dark:bg-orange-900 text-orange-700 dark:text-orange-300', border: 'border-orange-500', dot: 'bg-orange-500' },
};

function getCategoryColor(category: string | undefined) {
  const cat = categories.find(c => c.id === category);
  return colorMap[cat?.color ?? 'blue'];
}

function formatDate(date: Date | undefined) {
  if (!date) return '';
  return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout metadata={metadata}>
  <div class="max-w-4xl mx-auto px-4 py-14">

    <!-- Header -->
    <div class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-500 mb-3">Writing</p>
      <h1 class="text-4xl font-bold mb-4">Posts</h1>
      <p class="text-lg text-muted max-w-2xl">
        Analysis, observations, and practical thinking on AI, data strategy, and what it means to use data well — written for curious people, not just technical ones.
      </p>
    </div>

    <!-- Category overview -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-14">
      {categories.map(cat => {
        const colors = colorMap[cat.color];
        const count = sorted.filter(p => p.data.category === cat.id).length;
        return (
          <a href={`#${cat.id.toLowerCase().replace(/\s+&?\s*/g, '-')}`}
            class={`p-4 rounded-xl border-l-4 ${colors.border} bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow`}>
            <div class="flex items-center justify-between mb-1">
              <span class="font-semibold text-sm">{cat.label}</span>
              <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${colors.badge}`}>{count} {count === 1 ? 'post' : 'posts'}</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">{cat.description}</p>
          </a>
        );
      })}
    </div>

    <!-- Posts by category -->
    {categories.map(cat => {
      const posts = sorted.filter(p => p.data.category === cat.id);
      if (posts.length === 0) return null;
      const colors = colorMap[cat.color];
      return (
        <section id={cat.id.toLowerCase().replace(/\s+&?\s*/g, '-')} class="mb-14">
          <div class={`flex items-center gap-3 mb-6 pb-2 border-b border-gray-200 dark:border-gray-700`}>
            <div class={`w-3 h-3 rounded-full ${colors.dot} flex-shrink-0`}></div>
            <h2 class="text-xl font-bold">{cat.label}</h2>
            <span class={`text-xs px-2 py-0.5 rounded-full ${colors.badge}`}>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
          </div>
          <div class="space-y-6">
            {posts.map(post => (
              <article class={`pl-5 border-l-2 ${colors.border} hover:pl-6 transition-all`}>
                <a href={getPermalink(post.id, 'post')} class="group block">
                  <p class="text-xs text-muted mb-1">{formatDate(post.data.publishDate)}</p>
                  <h3 class="font-semibold text-base group-hover:text-blue-500 transition-colors mb-1">
                    {post.data.title}
                  </h3>
                  {post.data.excerpt && (
                    <p class="text-sm text-muted leading-relaxed">{post.data.excerpt}</p>
                  )}
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {post.data.tags.map(tag => (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-gray-400">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <!-- Empty state -->
    {sorted.length === 0 && (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">Posts coming soon.</p>
      </div>
    )}

  </div>
</Layout>
